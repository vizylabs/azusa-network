# VizyLabs Webhook (Already built-in as default, can also be overridden here)
WEBHOOK_URL=https://move.vizylabs.com/webhook/506ffde9-4381-4fae-8377-375f71b9d0d6

# Stripe Credit Card & ACH Recurring Billing
# Paste your Stripe Secret Key (sk_live_... or sk_test_...) in Vercel -> Settings -> Environment Variables
# to automatically enable live credit card checkout for Associate ($29/mo), Credentialed ($59/mo), and Church ($149/mo):
STRIPE_SECRET_KEY=

# Optional: If you prefer using existing Stripe Price IDs or Payment Links instead of auto-created prices:
STRIPE_PRICE_ASSOCIATE=
STRIPE_PRICE_MINISTER=
STRIPE_PRICE_CHURCH=
STRIPE_LINK_ASSOCIATE=
STRIPE_LINK_MINISTER=
STRIPE_LINK_CHURCH=
